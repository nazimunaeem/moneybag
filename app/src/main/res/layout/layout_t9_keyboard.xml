<?xml version="1.0" encoding="utf-8"?>
<!-- Pixel-style T9: flat, high-contrast, no rounded cards -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="3"
        android:rowCount="5">

        <Button style="@style/T9ButtonStyle" android:id="@+id/btn1" android:text="1" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btn2" android:text="2" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btn3" android:text="3" />

        <Button style="@style/T9ButtonStyle" android:id="@+id/btn4" android:text="4" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btn5" android:text="5" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btn6" android:text="6" />

        <Button style="@style/T9ButtonStyle" android:id="@+id/btn7" android:text="7" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btn8" android:text="8" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btn9" android:text="9" />

        <Button style="@style/T9ButtonStyle" android:id="@+id/btnDot" android:text="." />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btn0" android:text="0" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btnDelete" android:text="⌫"
            android:textColor="?attr/colorError" />

        <Button style="@style/T9ButtonStyle" android:id="@+id/btnMinus" android:text="-" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btnEqual" android:text="=" />
        <Button style="@style/T9ButtonStyle" android:id="@+id/btnDone" android:text="Next ›"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <!-- Hidden stubs for view binding compatibility -->
        <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </GridLayout>
</LinearLayout>
