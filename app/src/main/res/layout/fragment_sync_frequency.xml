<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Sync Frequency" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Choose how often you want to sync your data with the cloud."
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <RadioGroup
        android:id="@+id/radioGroupSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Manual Only"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioHourly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Every Hour"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioDaily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Every Day"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioWeekly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Every Week"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSync"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="SAVE SETTINGS"
        app:cornerRadius="0dp" />

</LinearLayout>
